///|
fn validator_support_valid_values_match(
  value : @model.IonValue,
  candidate : @model.IonValue,
) -> Bool {
  if validator_support_has_annotation(candidate, "range") {
    validator_support_range_contains(value, candidate)
  } else {
    validator_support_valid_values_equal(value, candidate)
  }
}

///|
fn validator_support_range_contains(
  value : @model.IonValue,
  range : @model.IonValue,
) -> Bool {
  if value.is_null() {
    return false
  }
  match range.without_annotations() {
    @model.IonValue::List([minimum, maximum]) => {
      let minimum_matches = if validator_support_is_minimum(minimum) {
        true
      } else {
        match validator_support_compare_values(value, minimum) {
          Some(order) =>
            order > 0 ||
            (
              order == 0 &&
              !validator_support_has_annotation(minimum, "exclusive")
            )
          None => false
        }
      }
      let maximum_matches = if validator_support_is_maximum(maximum) {
        true
      } else {
        match validator_support_compare_values(value, maximum) {
          Some(order) =>
            order < 0 ||
            (
              order == 0 &&
              !validator_support_has_annotation(maximum, "exclusive")
            )
          None => false
        }
      }
      minimum_matches && maximum_matches
    }
    _ => false
  }
}

