///|
fn validator_support_binary16_float_compatible(value : Float) -> Bool {
  let bits = value.reinterpret_as_uint()
  let exponent_bits = ((bits >> 23) & 0xFFU).reinterpret_as_int()
  let fraction_bits = bits & 0x7FFFFFU
  if exponent_bits == 0xFF {
    true
  } else if exponent_bits == 0 {
    fraction_bits == 0U
  } else {
    let exponent = exponent_bits - 127
    let significand = fraction_bits | 0x800000U
    if exponent > 15 {
      false
    } else if exponent >= -14 {
      (significand & 0x1FFFU) == 0U
    } else if exponent < -24 {
      false
    } else {
      let discarded_bits = -exponent - 1
      let mask = (1U << discarded_bits) - 1U
      (significand & mask) == 0U
    }
  }
}

///|
fn validator_support_ieee754_float_compatible(
  value : @model.IonValue,
  format : String,
) -> Bool {
  if value.is_null() {
    return false
  }
  match value.without_annotations() {
    @model.IonValue::Float(float) =>
      match format {
        "binary16" => validator_support_binary16_float_compatible(float)
        "binary32" | "binary64" => true
        _ => false
      }
    _ => false
  }
}

