        (@model.IonValue::Timestamp(left), @model.IonValue::Timestamp(right)) =>
          Some(validator_support_compare_timestamps(left, right))
        _ => None
      }
  }
}

///|
fn validator_support_power(base : Int, exponent : Int) -> @bigint.BigInt {
  @bigint.BigInt::pow(
    @bigint.BigInt::from_int(base),
    @bigint.BigInt::from_int(exponent),
  )
}

///|
fn validator_support_number_parts(
  value : @model.IonValue,
) -> (@bigint.BigInt, Int)? {
  match value.without_annotations() {
    @model.IonValue::Int(value) => Some((value, 0))
    @model.IonValue::Decimal(value) =>
      Some((value.coefficient(), value.exponent()))
    @model.IonValue::Float(value) => validator_support_float_parts(value)
    _ => None
  }
}

///|
fn validator_support_float_parts(value : Float) -> (@bigint.BigInt, Int)? {
  let bits = value.reinterpret_as_uint()
  let exponent_bits = ((bits >> 23) & 0xFF).reinterpret_as_int()
  let fraction_bits = (bits & 0x7FFFFF).reinterpret_as_int()
  if exponent_bits == 0xFF {
    return None
  }
  let significand = if exponent_bits == 0 {
    fraction_bits
  } else {
    fraction_bits + 0x800000
  }
  let binary_exponent = if exponent_bits == 0 {
    -149
  } else {
    exponent_bits - 127 - 23
  }
  let mut coefficient = @bigint.BigInt::from_int(significand)
  let decimal_exponent = if binary_exponent >= 0 {
    coefficient = coefficient * validator_support_power(2, binary_exponent)
    0
  } else {
    coefficient = coefficient * validator_support_power(5, -binary_exponent)
    binary_exponent
  }
  if (bits & 0x80000000) != 0 {
    coefficient = coefficient.neg()
  }
  Some((coefficient, decimal_exponent))
}

///|
fn validator_support_compare_decimal_parts(
  left_coefficient : @bigint.BigInt,
  left_exponent : Int,
  right_coefficient : @bigint.BigInt,
  right_exponent : Int,
) -> Int {
  let left_sign = left_coefficient.compare_int(0)
  let right_sign = right_coefficient.compare_int(0)
  if left_sign != right_sign {
    return if left_sign < right_sign { -1 } else { 1 }
  }
  if left_sign == 0 {
    return 0
  }
  let left_order = @bigint.BigInt::from_int(
      left_coefficient.to_string().length(),
    ) +
    @bigint.BigInt::from_int(left_exponent)
  let right_order = @bigint.BigInt::from_int(
      right_coefficient.to_string().length(),
    ) +
    @bigint.BigInt::from_int(right_exponent)
  let order = left_order.compare(right_order)
  if order != 0 {
    return if left_sign < 0 { -order } else { order }
  }
  let common_exponent = if left_exponent < right_exponent {
    left_exponent
  } else {
    right_exponent
  }
  let left_scaled = left_coefficient *
    validator_support_power(10, left_exponent - common_exponent)
  let right_scaled = right_coefficient *
    validator_support_power(10, right_exponent - common_exponent)
  left_scaled.compare(right_scaled)
}

///|
fn validator_support_is_leap_year(year : Int) -> Bool {
  year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

///|
fn validator_support_days_in_month(year : Int, month : Int) -> Int {
  match month {
    1 | 3 | 5 | 7 | 8 | 10 | 12 => 31
    4 | 6 | 9 | 11 => 30
    2 => if validator_support_is_leap_year(year) { 29 } else { 28 }
    _ => 30
  }
}

///|
fn validator_support_timestamp_seconds(
  timestamp : @model.IonTimestamp,
) -> @bigint.BigInt {
  let previous_year = @bigint.BigInt::from_int(timestamp.year()) -
    @bigint.BigInt::from_int(1)
  let mut days = previous_year * @bigint.BigInt::from_int(365) +
    previous_year / @bigint.BigInt::from_int(4) -
    previous_year / @bigint.BigInt::from_int(100) +
    previous_year / @bigint.BigInt::from_int(400)
  let month = timestamp.month().unwrap_or(1)
  for prior_month in 1..<month {
    days = days +
      @bigint.BigInt::from_int(
        validator_support_days_in_month(timestamp.year(), prior_month),
      )
  }
  if month > 2 && validator_support_is_leap_year(timestamp.year()) {
    days = days + @bigint.BigInt::from_int(1)
  }
  days = days + @bigint.BigInt::from_int(timestamp.day().unwrap_or(1) - 1)
  let local_seconds = timestamp.hour().unwrap_or(0) * 3600 +
    timestamp.minute().unwrap_or(0) * 60 +
    timestamp.second().unwrap_or(0)
  days * @bigint.BigInt::from_int(86400) +
  @bigint.BigInt::from_int(local_seconds) -
  @bigint.BigInt::from_int(timestamp.offset_minutes().unwrap_or(0) * 60)
}

///|
fn validator_support_compare_timestamps(
  left : @model.IonTimestamp,
  right : @model.IonTimestamp,
) -> Int {
  let seconds_order = validator_support_timestamp_seconds(left).compare(
    validator_support_timestamp_seconds(right),
  )
  if seconds_order != 0 {
    return seconds_order
  }
  let left_fraction = left
    .fraction_coefficient()
    .unwrap_or(@bigint.BigInt::from_int(0))
  let left_exponent = left.fraction_exponent().unwrap_or(0)
  let right_fraction = right
    .fraction_coefficient()
    .unwrap_or(@bigint.BigInt::from_int(0))
  let right_exponent = right.fraction_exponent().unwrap_or(0)
  validator_support_compare_decimal_parts(
    left_fraction, left_exponent, right_fraction, right_exponent,
  )
}

///|
fn validator_support_decimal_precision(value : @model.IonValue) -> Int? {
  if value.is_null() {
    return None
  }
  match value.without_annotations() {
    @model.IonValue::Decimal(decimal) => {
      let coefficient : @bigint.BigInt = decimal.coefficient()
      let digits = coefficient.to_string().length()
      let sign_digits = if coefficient.compare_int(0) < 0 { 1 } else { 0 }
      Some(digits - sign_digits)
    }
    _ => None
  }
}

///|
fn validator_support_decimal_exponent(value : @model.IonValue) -> Int? {
  if value.is_null() {
    return None
  }
  match value.without_annotations() {
    @model.IonValue::Decimal(decimal) => Some(decimal.exponent())
    _ => None
  }
}

///|
fn validator_support_timestamp_precision(value : @model.IonValue) -> Int? {
  if value.is_null() {
    return None
  }
  match value.without_annotations() {
    @model.IonValue::Timestamp(timestamp) => {
      if timestamp.year() <= 0 {
        return None
      }
      if timestamp.second() is Some(_) {
        match
          (timestamp.fraction_exponent(), timestamp.fraction_coefficient()) {
          (Some(exponent), Some(_)) if exponent < 0 => Some(12 - exponent)
          (None, None) => Some(12)
          _ => None
        }
      } else if timestamp.minute() is Some(_) {
        Some(9)
      } else if timestamp.day() is Some(_) {
        Some(6)
      } else if timestamp.month() is Some(_) {
        Some(3)
      } else {
        Some(0)
      }
    }
    _ => None
  }
}

///|
fn validator_support_timestamp_offset_is_allowed(
  value : @model.IonValue,
  allowed_offsets : Array[Int?],
) -> Bool {
  if value.is_null() {
    return false
  }
  match value.without_annotations() {
    @model.IonValue::Timestamp(timestamp) =>
      for offset in allowed_offsets {
        if timestamp.offset_minutes() == offset {
          return true
        }
      }
    _ => ()
  }
  false
}

