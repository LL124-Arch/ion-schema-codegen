fn validator_support_structs_equal(
  left : Array[(@model.IonSymbol, @model.IonValue)],
  right : Array[(@model.IonSymbol, @model.IonValue)],
) -> Bool {
  if left.length() != right.length() {
    return false
  }
  let matched : Array[Bool] = []
  for _ in right {
    matched.push(false)
  }
  for (left_symbol, left_value) in left {
    let mut index = 0
    let mut found = false
    for (right_symbol, right_value) in right {
      if !matched[index] &&
        validator_support_symbols_equal(left_symbol, right_symbol) &&
        validator_support_values_equal(left_value, right_value) {
        matched[index] = true
        found = true
        break
