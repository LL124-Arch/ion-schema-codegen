    (@model.IonValue::Decimal(left), @model.IonValue::Decimal(right)) =>
      left.coefficient() == right.coefficient() &&
      left.exponent() == right.exponent()
    (@model.IonValue::Timestamp(left), @model.IonValue::Timestamp(right)) =>
      left == right
    (@model.IonValue::Symbol(left), @model.IonValue::Symbol(right)) =>
      validator_support_symbols_equal(left, right)
    (@model.IonValue::String(left), @model.IonValue::String(right)) =>
      left == right
    (@model.IonValue::Blob(left), @model.IonValue::Blob(right)) => left == right
    (@model.IonValue::Clob(left), @model.IonValue::Clob(right)) => left == right
    (@model.IonValue::List(left), @model.IonValue::List(right))
    | (@model.IonValue::Sexp(left), @model.IonValue::Sexp(right)) =>
      validator_support_sequences_equal(left, right)
    (@model.IonValue::Struct(left), @model.IonValue::Struct(right)) =>
      validator_support_structs_equal(left, right)
    _ => false
  }
