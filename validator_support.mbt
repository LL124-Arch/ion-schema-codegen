    @model.IonValue::Sexp(elements) => Some(elements.length())
    @model.IonValue::Struct(fields) => Some(fields.length())
    _ => None
  }
}

///|
fn validator_support_codepoint_length(value : @model.IonValue) -> Int? {
  match value.without_annotations() {
    @model.IonValue::String(text) => Some(text.char_length())
    @model.IonValue::Symbol(symbol) =>
      match symbol.text_value() {
        Some(text) => Some(text.char_length())
        None => None
      }
    _ => None
  }
}

///|
fn validator_support_utf8_byte_length(value : @model.IonValue) -> Int? {
  let text = match value.without_annotations() {
    @model.IonValue::String(text) => Some(text)
    @model.IonValue::Symbol(symbol) => symbol.text_value()
    _ => None
  }
  match text {
    Some(text) => {
      let mut byte_count = 0
      for character in text {
        let codepoint = character.to_int()
        byte_count += if codepoint <= 0x7F {
          1
        } else if codepoint <= 0x7FF {
          2
        } else if codepoint <= 0xFFFF {
          3
        } else {
          4
        }
      }
      Some(byte_count)
    }
    None => None
  }
}

///|
fn validator_support_annotations_match(
  value : @model.IonValue,
  allowed : Array[String],
  closed : Bool,
  required : Bool,
) -> Bool {
  let annotations = value.annotations()
  if required {
    for expected in allowed {
      let mut found = false
      for actual in annotations {
        if actual.text_value() == Some(expected) {
          found = true
          break
        }
      }
      if !found {
        return false
      }
    }
  }
  if closed {
    for actual in annotations {
      let text = match actual.text_value() {
        Some(text) => text
        None => return false
      }
      let mut allowed_annotation = false
      for expected in allowed {
        if expected == text {
          allowed_annotation = true
          break
        }
      }
      if !allowed_annotation {
        return false
      }
    }
  }
  true
}

///|
fn validator_support_regex_matches(
  value : @model.IonValue,
  pattern : String,
) -> Bool {
  if value.is_null() {
    return false
  }
  let text = match value.without_annotations() {
    @model.IonValue::String(text) => Some(text)
    @model.IonValue::Symbol(symbol) => symbol.text_value()
    _ => None
  }
  match text {
    Some(text) => {
      let regex = @string.Regex(pattern) catch { _ => return false }
      regex.execute(text) is Some(_)
    }
    None => false
  }
}
